# 此文件只是字段说明。安装入口在本目录生成 .env，自动填随机密码与可用端口。
# 不要把开发项目根目录的 .env 复制进来。
INSTALL_ID=
LOCAL_APP_PORT=17401
LOCAL_S3_PORT=17413
LOCAL_CONSOLE_PORT=17414
LOCAL_PG_PASSWORD=
LOCAL_S3_PASSWORD=
LOCAL_JWT_SECRET=
# 北京地域百炼密钥；不写入镜像，也不随安装包分发。
DASHSCOPE_API_KEY=
PLANNER_MODEL=qwen3.6-flash
# 无密钥时 mock 生成占位图，非真实AI生图。启动入口不会提交任何生成任务。
IMAGE_PROVIDER=mock
BACKGROUND_PROVIDER=disabled
OUTPAINTING_PROVIDER=disabled
UPSCALING_PROVIDER=disabled
REGION_PROVIDER=disabled
REFERENCE_GENERATION_ENABLED=false
